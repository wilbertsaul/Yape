APP_NAME=AlToque
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://altoque.jemigra.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yape
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"

# SUNAT (producción)
SUNAT_AMBIENTE=produccion
SUNAT_SERIE=EB01
SUNAT_SERIE_NC=BNC1
SUNAT_CERT_FILE=certificate.pfx
SUNAT_CERT_PASSWORD=
SUNAT_RUC=
SUNAT_RAZON_SOCIAL=
SUNAT_NOMBRE_COMERCIAL=AlToque
SUNAT_DIRECCION=
SUNAT_UBIGEO=170101
SUNAT_DEPARTAMENTO=MADRE DE DIOS
SUNAT_PROVINCIA=TAMBOPATA
SUNAT_DISTRITO=TAMBOPATA
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=

# Usuario secundario SOL con permisos SEE (obligatorio en producción)
SUNAT_USUARIO_SOL_SEC=
SUNAT_CLAVE_SOL_SEC=

# Gmail API - credentials.json debe estar en storage/app/
# Luego de autenticar, el token se guarda en storage/app/gmail_token.json
